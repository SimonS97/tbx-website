---
import type { WorkHeroImage } from "../../lib/works";

interface Props {
  image: WorkHeroImage;
  eager?: boolean;
}

const { image, eager = false } = Astro.props;
const src = image.src.src;

const aspectRatio = image.aspectRatio ?? 2 / 3;
---

<figure class="work-hero" style={`--work-hero-aspect-ratio: ${aspectRatio}`}>
  <img
    src={src}
    alt={image.alt}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
  />
</figure>
