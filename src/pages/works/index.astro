---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorksCatalog from "../../components/works/WorksCatalog.astro";
import { getPublishedWorks } from "../../lib/works";

const publishedWorks = await getPublishedWorks();
---

<BaseLayout
  title="Works"
  description="Published tabletop works by Tales by Xero."
  currentPath="/works"
  mainClass="works-catalog-main"
>
  <WorksCatalog works={publishedWorks} />
</BaseLayout>
